# --- Vòng Kim Cô backend ---

# Public-facing URL (used in OAuth redirect and desktop authorize links)
PUBLIC_URL=https://vongkimco.hoctuthien.com

# HTTP port
PORT=8080

# SQLite location (auto-created)
DATABASE_URL=sqlite://./data/vongkimco.db?mode=rwc

# Where uploaded screenshots are written (path on disk)
SCREENSHOT_DIR=./data/screenshots

# Max accepted size for a single screenshot upload (bytes). Default 2 MiB.
MAX_SCREENSHOT_BYTES=2097152

# Comma-separated list of admin emails. Only these accounts can access /admin.
ADMIN_EMAILS=dvcuong.hust@gmail.com

# Comma-separated list of member emails (allow-list for desktop login).
# Admins are implicitly members. Additional members can also be added later
# by admins via the web UI at /admin/members, including approving requests
# submitted by guests.
MEMBER_EMAILS=hoctuthien11@gmail.com,dhammacode@gmail.com

# Maintainer contact shown on the public "account pending" and feedback pages.
MAINTAINER_FACEBOOK=https://fb.com/dvcuong.hust
MAINTAINER_EMAIL=dvcuong.hust@gmail.com

# Google OAuth (create at https://console.cloud.google.com/apis/credentials)
#   Authorized redirect URI: https://vongkimco.hoctuthien.com/admin/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# HS256 signing key for desktop access-token JWTs. REQUIRED — must be a
# random string ≥ 32 chars. The server refuses to start without it.
# Generate: openssl rand -hex 32
JWT_SECRET=

# Max number of active devices a non-admin user may pair. Admins are
# unlimited. Set to 0 to disable the cap for members too. Default 5.
DESKTOP_DEVICE_LIMIT=5

# IANA timezone used to render timestamps in the admin web UI. Storage stays
# UTC; this only affects display. Default Asia/Ho_Chi_Minh.
APP_TIMEZONE=Asia/Ho_Chi_Minh

# Logging filter
RUST_LOG=info,sqlx=warn,tower_http=info
