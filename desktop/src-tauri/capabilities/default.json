{
    "$schema": "../gen/schemas/desktop-schema.json",
    "identifier": "default",
    "description": "Default capabilities granted to the main window",
    "windows": ["main"],
    "permissions": [
        "core:default",
        "shell:default",
        "shell:allow-open",
        "store:default",
        "dialog:default",
        "os:default",
        "notification:default",
        "global-shortcut:default",
        "autostart:default",
        "updater:default",
        "process:default",
        "process:allow-restart"
    ]
}
