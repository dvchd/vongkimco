# Copy to `.env` in Coolify and configure these values.

# Domain
PUBLIC_URL=https://vongkimco.hoctuthien.com

# Admin allow-list (comma-separated). Only emails in this list become admins
# on first Google sign-in.
ADMIN_EMAILS=dvcuong.hust@gmail.com

# Member allow-list (comma-separated). Only members can pair a desktop device
# with this server. Admins are implicitly members. Guests can post feedback
# without being members and can request membership via /pending. Additional
# members can be added at runtime via /admin/members.
MEMBER_EMAILS=hoctuthien11@gmail.com,dhammacode@gmail.com

# Maintainer contact info shown on the "pending approval" and feedback pages.
MAINTAINER_FACEBOOK=https://fb.com/dvcuong.hust
MAINTAINER_EMAIL=dvcuong.hust@gmail.com

# Google OAuth — create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI MUST be: ${PUBLIC_URL}/admin/oauth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cookie signing key — any random string ≥ 32 chars. CHANGE IN PRODUCTION.
# Generate: openssl rand -hex 32
SESSION_SECRET=please-change-me-to-a-long-random-string-32b+

# Optional
RUST_LOG=info,sqlx=warn,tower_http=info
